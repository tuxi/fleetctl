{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fleetctl",
  "version": "0.5.0",
  "identifier": "io.fleetctl.desktop",
  "build": {
    "frontendDist": "../prototype"
  },
  "app": {
    "windows": [
      {
        "title": "fleetctl · 设备验机工作台",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data: http://127.0.0.1:4174; connect-src 'self' http://127.0.0.1:4174"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": ["binaries/fleetctl-bridge"]
  }
}
